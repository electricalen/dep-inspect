{
  "name": "dep-inspect",
  "version": "0.1.1",
  "description": "A dependency red flag analyzer and policy enforcement tool for npm projects",
  "type": "module",
  "bin": {
    "dep-inspect": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "validate": "pnpm typecheck && pnpm lint && pnpm test:run",
    "release:check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test:run && pnpm build && node dist/index.js --help",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm release:check",
    "prepare": "husky"
  },
  "keywords": [
    "npm",
    "dependencies",
    "security",
    "audit",
    "risk",
    "license",
    "cli",
    "supply-chain"
  ],
  "author": "David Sawyer <electricalen@gmail.com>",
  "homepage": "https://github.com/electricalen/dep-inspect",
  "bugs": {
    "url": "https://github.com/electricalen/dep-inspect/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electricalen/dep-inspect.git"
  },
  "license": "MIT",
  "dependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@yarnpkg/lockfile": "^1.1.0",
    "better-sqlite3": "^11.8.1",
    "chalk": "^5.4.1",
    "commander": "^14.0.0",
    "neverthrow": "^8.2.0",
    "semver": "^7.7.1",
    "yaml": "^2.7.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@fast-check/vitest": "^0.2.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/semver": "^7.7.0",
    "@vitest/coverage-v8": "^3.1.1",
    "eslint": "^9.25.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.1.1"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
